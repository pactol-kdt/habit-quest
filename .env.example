# HabitQuest environment variables
#
# Local development:
#   cp .env.example .env.local
#   # then edit AUTH_SECRET / DATABASE_URL / VAPID keys
#
# Production:
#   cp .env.production.example .env.production
#
# Next.js always loads `.env.local` (gitignored) and it overrides other env files.

# -----------------------------------------------------------------------------
# Shared keys
# -----------------------------------------------------------------------------

# Session signing secret (16+ chars; use 32+ in production)
AUTH_SECRET=dev-only-change-me-habitquest-secret-key

# PostgreSQL connection string
# Local:  postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE
# Neon:   postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/habitquest

# Web Push (VAPID). Regenerate with: npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@habitquest.local

# Optional: protect /api/cron/reminders (Bearer token)
# CRON_SECRET=replace-me

# Optional: this email becomes admin on signup (first account is always admin)
# ADMIN_EMAIL=you@example.com
