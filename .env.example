# HabitQuest environment variables
#
# Next.js loads these by mode:
#   next dev   → .env.development  (+ optional .env.development.local)
#   next start → .env.production   (+ optional .env.production.local)
#   always     → .env.local overrides (gitignored)
#
# Copy templates:
#   cp .env.development .env.development.local   # optional local overrides
#   cp .env.production.example .env.production   # fill real secrets for deploy

# -----------------------------------------------------------------------------
# Shared keys
# -----------------------------------------------------------------------------

# Session signing secret (16+ chars; use 32+ in production)
AUTH_SECRET=dev-only-change-me-habitquest-secret-key

# MySQL connection string
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=mysql://root@127.0.0.1:3306/habitquest

# Optional: this email becomes admin on signup (first account is always admin)
# ADMIN_EMAIL=you@example.com
