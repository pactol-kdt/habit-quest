# Template for production. Copy to `.env.production` or your host's env UI
# (Vercel / Docker / systemd). Never commit real production secrets.

# Required: 32+ random characters. Example generator:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Required: hosted PostgreSQL connection string (Neon / Railway / etc.)
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Optional: this email becomes admin on signup (in addition to the first account)
# ADMIN_EMAIL=admin@yourdomain.com
