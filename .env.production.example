# Template for production. Copy to `.env.production` or your host's env UI
# (Vercel / Docker / systemd). Never commit real production secrets.

# Required: 32+ random characters. Example generator:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Required: hosted MySQL connection string
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=mysql://habitquest:PASSWORD@db.example.com:3306/habitquest

# Optional: this email becomes admin on signup (in addition to the first account)
# ADMIN_EMAIL=admin@yourdomain.com
