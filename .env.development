# Loaded automatically by `next dev` (NODE_ENV=development).
# Override with `.env.development.local` if needed (gitignored).

AUTH_SECRET=dev-only-change-me-habitquest-secret-key

# Local MySQL (Laragon / Docker / Homebrew defaults)
DATABASE_URL=mysql://root@127.0.0.1:3306/habitquest

