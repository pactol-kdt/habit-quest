# Loaded automatically by `next dev` (NODE_ENV=development).
# Override with `.env.development.local` if needed (gitignored).

AUTH_SECRET=dev-only-change-me-habitquest-secret-key

# Local PostgreSQL (pgAdmin / Docker / Homebrew defaults)
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/habitquest

# Optional: force this email to admin on signup (first account is always admin)
# ADMIN_EMAIL=you@example.com
